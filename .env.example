# Copy to .env and fill in. Never commit .env.
# Names only — no values are stored in git.

# Server: Postgres (local: from `supabase status`; hosted: the pooler URL)
DATABASE_URL=

# Server: Supabase project (local or hosted)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local CLI 2.122 signs JWTs asymmetrically (ES256); verify against JWKS, locally and hosted:
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Server: auth mode (dev | supabase). dev is refused when NODE_ENV=production.
AUTH_MODE=

# Server: CORS origins, comma-separated
ALLOWED_ORIGINS=

# Server: WS heartbeat ("1" relaxes 3s x 2 to 15s x 10 for loaded dev/e2e boxes)
WS_PING_RELAXED=

# Server: LLM (decision D5: Muse Spark through the Meta Model API)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Ports (HANDOFF.md section 5 slots; defaults: web 5173, server 2567)
WEB_PORT=
PORT=
VITE_SERVER_URL=

# Web (Vite, set at build time when deployed)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_MODE=
# Web: data layer (mock | http)
VITE_API=

{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["WEB_PORT", "PORT", "VITE_SERVER_URL", "VITE_SUPABASE_URL", "VITE_SUPABASE_ANON_KEY", "VITE_AUTH_MODE", "VITE_API", "DATABASE_URL", "SUPABASE_URL", "SUPABASE_ANON_KEY", "SUPABASE_SERVICE_ROLE_KEY", "SUPABASE_JWKS_URL", "AUTH_MODE", "ALLOWED_ORIGINS", "LLM_PROVIDER", "LLM_BASE_URL", "LLM_API_KEY", "LLM_MODEL", "WS_PING_RELAXED"]
    },
    "typecheck": {},
    "lint": {},
    "test": {}
  }
}

{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["WEB_PORT", "PORT", "VITE_SERVER_URL", "VITE_SUPABASE_URL", "VITE_SUPABASE_ANON_KEY", "VITE_AUTH_MODE", "VITE_API"]
    },
    "typecheck": {},
    "lint": {},
    "test": {}
  }
}
